# GEMINI_API_KEY: Required for optional real Gemini AI adapter calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="PLACEHOLDER_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# BAYORA CONTROL PLANE CONFIGURATION (Placeholders only — never commit real secrets)
BAYORA_DB_PATH="./bayora.db"
BAYORA_BACKEND_PORT="8000"
BAYORA_TARGET_ADAPTER_MODE="MOCK_DETERMINISTIC_V1"
BAYORA_RED_WORKER_TOKEN="PLACEHOLDER_RED_WORKER_TOKEN"
BAYORA_BLUE_WORKER_TOKEN="PLACEHOLDER_BLUE_WORKER_TOKEN"
BAYORA_EVALUATOR_TOKEN="PLACEHOLDER_EVALUATOR_TOKEN"
BAYORA_EXECUTION_TIMEOUT_MS="5000"
